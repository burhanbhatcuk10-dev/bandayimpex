# ---- Server ----
PORT=4000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/britannia
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=britannia
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@britannia.local
ADMIN_USERNAME=admin.bipl
ADMIN_PASSWORD=changeme123

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=britannia
